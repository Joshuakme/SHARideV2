<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="text_section_title">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textSize">@dimen/fs_profile_section_title</item>
        <item name="android:layout_marginBottom">@dimen/ss_profile_section_title_bottom_margin</item>
    </style>

    <style name="text_fragment_title">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/ss_screen_top_margin</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="android:textSize">@dimen/fs_fragment_title</item>
    </style>

    <!--  Home: TabLayout Style  -->
    <!-- Style for the text appearance of the tabs -->
    <style name="TabTextStyle" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="CustomTabLayout" parent="Widget.Design.TabLayout">
        <item name="tabIndicatorFullWidth">false</item>
    </style>

    <style name="LeftTab" parent="Widget.Design.TabLayout">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/left_tab_background</item>
        <item name="android:textAppearance">@style/TabTextStyle</item>
    </style>

    <style name="RightTab" parent="Widget.Design.TabLayout">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/right_tab_background</item>
        <item name="android:textAppearance">@style/TabTextStyle</item>
    </style>
</resources>