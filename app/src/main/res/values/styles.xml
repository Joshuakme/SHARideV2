<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="text_section_title">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textSize">@dimen/fs_profile_section_title</item>
        <item name="android:layout_marginBottom">@dimen/ss_profile_section_title_bottom_margin</item>
    </style>

    <style name="text_fragment_title">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/ss_screen_top_margin</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textSize">@dimen/fs_fragment_title</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="text_fragment_title_profile">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textSize">@dimen/fs_profile_subfragment_title</item>
    </style>

    <!--  Home: TabLayout Style  -->
    <!-- Style for the text appearance of the tabs -->
    <style name="TabTextStyle" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorOnSecondary</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="textAllCaps">false</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="CustomTabLayout" parent="Widget.Design.TabLayout">
        <item name="tabIndicatorFullWidth">true</item>
    </style>


    <!--  Home: Custom Image Card Style  -->
    <style name="ImageCardViewStyle" parent="@style/Widget.MaterialComponents.CardView">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay_image_card_custom_corners</item>
    </style>


    <style name="ShapeAppearanceOverlay_image_card_custom_corners" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
    </style>

    <!--  Login Bottom Dialog Animation  -->
    <style name="BottomDialogAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_in_bottom</item>
        <item name="android:windowExitAnimation">@anim/slide_out_bottom</item>
    </style>


    <!--  Date Time Scroll Picker  -->
    <style name="DatePickerStyle" parent="Widget.MaterialDatePicker">
        <item name="android:textAppearance">@style/TextAppearance.DatePicker</item>
        <item name="android:background">?attr/colorSurfaceContainer</item>
        <item name="highlighterColor">?attr/colorPrimary</item>
        <item name="isShowHighlighter">true</item>
        <item name="highlighterHeight">55dp</item>
        <item name="fadeInAlpha">.3</item>
        <item name="fadeOutAlpha">.7</item>
        <item name="fadeInDuration">300</item>
        <item name="fadeOutDuration">1000</item>
        <item name="minYear">1995</item>
        <item name="maxYear">2050</item>
        <item name="defaultYear">2021</item>
        <item name="defaultMonth">1</item>
        <item name="defaultDay">1</item>
        <item name="dateFormat">DD_MMM_YYYY</item>
    </style>

    <style name="TimePickerStyle" parent="Widget.MaterialTimePicker">
        <item name="android:textAppearance">@style/TextAppearance.TimePicker</item>
        <item name="android:background">?attr/colorSurfaceContainer</item>
        <item name="highlighterColor">?attr/colorPrimary</item>
        <item name="highlighterHeight">60dp</item>
        <item name="isShowHighlighter">true</item>
        <item name="timeConvention">HOURS_12</item>
        <item name="fadeInAlpha">.3</item>
        <item name="fadeOutAlpha">.7</item>
        <item name="fadeInDuration">300</item>
        <item name="fadeOutDuration">1000</item>
        <item name="defaultHour">10</item>
        <item name="defaultMinute">30</item>
    </style>

    <style name="TextAppearance.TimePicker" parent="@style/TextAppearance.MaterialTimePicker">
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">?attr/colorError</item>
    </style>

    <style name="TextAppearance.DatePicker" parent="@style/TextAppearance.MaterialDatePicker">
        <item name="android:textSize">19sp</item>
        <item name="android:textColor">?attr/colorError</item>
    </style>

    <style name="text_fragment_title_profile">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textSize">@dimen/fs_profile_subfragment_title</item>
    </style>

    <!--  Home: TabLayout Style  -->
    <!-- Style for the text appearance of the tabs -->
    <style name="TabTextStyle" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorOnSecondary</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="textAllCaps">false</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="CustomTabLayout" parent="Widget.Design.TabLayout">
        <item name="tabIndicatorFullWidth">true</item>
    </style>


    <!--  Home: Custom Image Card Style  -->
    <style name="ImageCardViewStyle" parent="@style/Widget.MaterialComponents.CardView">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay_image_card_custom_corners</item>
    </style>


    <style name="ShapeAppearanceOverlay_image_card_custom_corners" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
    </style>

    <!--  Vehicle Fragment: Spinner Style  -->
    <style name="spinner_style">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@drawable/background_spinner</item>
        <item name="android:layout_margin">10dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:popupBackground">#DFFFFFFF</item>
    </style>
</resources>