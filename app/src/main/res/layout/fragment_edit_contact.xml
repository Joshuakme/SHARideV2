<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:id="@+id/ll_edit_emergency_contact"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_edit_emergency_contact_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ss_screen_top_margin">

            <ImageButton
                android:id="@+id/btn_back_edit_contact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#00FFFFFF"
                android:scaleX="@dimen/ss_profile_subfragment_nav_icon_scale"

                android:scaleY="@dimen/ss_profile_subfragment_nav_icon_scale"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.069"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.454"
                app:srcCompat="@drawable/baseline_arrow_back_24"
                app:tint="?attr/colorOnBackground" />

            <TextView
                android:id="@+id/tv_edit_emergency_contact_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="70dp"
                android:layout_marginEnd="70dp"
                android:gravity="center"
                android:text="Edit Emergency Contact"
                android:textSize="@dimen/fs_fragment_title"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/btn_update_contact_detail"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/ss_screen_width_margin"
                android:text="Update"
                android:textColor="?attr/colorPrimary"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.5" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/ll_cv_edit_emergency_contact_details"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_contact_details"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardBackgroundColor="#00FFFFFF"
                app:cardElevation="0dp">

                <LinearLayout
                    android:id="@+id/ll_edit_emergency_contact_details"
                    android:layout_width="match_parent"
                    android:layout_height="698dp"
                    android:orientation="vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layout_edit_emergency_name"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ss_screen_width_margin"
                        android:layout_marginTop="24dp"
                        android:layout_marginEnd="@dimen/ss_screen_width_margin"
                        android:hint="Name"
                        app:boxCornerRadiusBottomEnd="@dimen/ss_rounded_background_corner_radius"
                        app:boxCornerRadiusBottomStart="@dimen/ss_rounded_background_corner_radius"
                        app:boxCornerRadiusTopEnd="@dimen/ss_rounded_background_corner_radius"
                        app:boxCornerRadiusTopStart="@dimen/ss_rounded_background_corner_radius"
                        app:helperText="Required*"
                        app:helperTextTextColor="@color/md_theme_error"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/tv_emergency_contact_title"
                        app:startIconDrawable="@drawable/baseline_account_circle_24">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/input_edit_emergency_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="15dp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layout_edit_emergency_phone_no"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ss_screen_width_margin"
                        android:layout_marginTop="24dp"
                        android:layout_marginEnd="@dimen/ss_screen_width_margin"
                        android:hint="Phone Number"
                        android:inputType="number"
                        android:maxLines="1"
                        app:boxCornerRadiusBottomEnd="@dimen/ss_rounded_background_corner_radius"
                        app:boxCornerRadiusBottomStart="@dimen/ss_rounded_background_corner_radius"
                        app:boxCornerRadiusTopEnd="@dimen/ss_rounded_background_corner_radius"
                        app:boxCornerRadiusTopStart="@dimen/ss_rounded_background_corner_radius"
                        app:counterEnabled="true"
                        app:helperText="Required*"
                        app:helperTextTextColor="@color/md_theme_error"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/layout_emergency_name"
                        app:prefixText="+60 "
                        app:prefixTextColor="?attr/colorOnBackground"
                        app:startIconDrawable="@drawable/baseline_phone_24">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/input_edit_emergency_phone_no"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:paddingVertical="15dp" />
                    </com.google.android.material.textfield.TextInputLayout>



                    <!--  Delete Button  -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btn_delete_contact"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/ss_screen_width_margin"
                        android:layout_marginTop="50dp"
                        app:cardBackgroundColor="?attr/colorError"
                        app:cardCornerRadius="@dimen/ss_rounded_background_corner_radius">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:fontFamily="@font/poppins_medium"
                            android:gravity="center"
                            android:paddingVertical="14dp"
                            android:text="Delete Contact"
                            android:textColor="?attr/colorOnPrimary" />

                    </com.google.android.material.card.MaterialCardView>


                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </LinearLayout>
</layout>
