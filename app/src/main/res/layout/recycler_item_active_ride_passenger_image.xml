<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_active_ride_item_passenger_image"
    android:layout_width="60dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="16dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_item_active_ride_passenger_image"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:clickable="false"
        android:contextClickable="false"
        app:cardCornerRadius="100000dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="?attr/colorPrimaryContainer"
        app:strokeWidth="1dp">


        <ImageView
            android:id="@+id/img_item_active_ride_passenger_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:clickable="false"
            android:contextClickable="false"
            android:cropToPadding="true"
            android:scaleType="centerCrop"
            app:srcCompat="@drawable/baseline_account_circle_24"
            app:tint="?attr/colorOnBackground" />

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/text_item_active_ride_passenger_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:clickable="false"
        android:contextClickable="false"
        android:gravity="center_horizontal"
        android:text="TextView"
        android:textColor="?android:attr/textColorHint"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/card_item_active_ride_passenger_image" />


    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_active_ride_passenger_status_badge"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:clickable="false"
        android:contextClickable="false"
        android:translationX="-14dp"
        app:cardBackgroundColor="?attr/colorPrimaryContainer"
        app:cardCornerRadius="100000dp"
        app:layout_constraintStart_toEndOf="@+id/card_item_active_ride_passenger_image"
        app:layout_constraintTop_toTopOf="@+id/card_item_active_ride_passenger_image"
        app:strokeWidth="0dp">

        <ImageButton
            android:id="@+id/img_active_ride_passenger_status_badge"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#00FFFFFF"
            android:scaleX="0.55"
            android:scaleY="0.55"
            android:src="@drawable/baseline_question_mark_24"
            app:tint="?attr/colorOnSurface" />
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>