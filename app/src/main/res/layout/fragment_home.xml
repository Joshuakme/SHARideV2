<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".screen.navigation.HomeFragment">


        <!--  User Info Section  -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_home_user_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorPrimaryVariant"
            android:paddingTop="@dimen/ss_home_nav_top_padding"
            android:paddingBottom="64dp"
            android:visibility="visible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible">

            <!--  Profile Picture  -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_home_user_profile_pic"
                android:layout_width="@dimen/ss_home_pic_size"
                android:layout_height="@dimen/ss_home_pic_size"
                android:layout_marginStart="@dimen/ss_screen_width_margin"
                app:cardBackgroundColor="#00FFFFFF"
                app:cardCornerRadius="1000dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="#00FFFFFF">

                <ImageView
                    android:id="@+id/img_user_profile_pic"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:srcCompat="@drawable/baseline_account_circle_24"
                    app:tint="?attr/colorOnPrimary" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/text_home_welcome_user"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="@font/poppins_bold"
                android:text="@string/home_fragment_welcome_user"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="20sp"
                app:layout_constraintBottom_toTopOf="@+id/img_home_welcome_user_location"
                app:layout_constraintStart_toEndOf="@+id/card_home_user_profile_pic"
                app:layout_constraintTop_toTopOf="@+id/card_home_user_profile_pic" />

            <ImageView
                android:id="@+id/img_home_welcome_user_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:scaleX="0.9"
                android:scaleY="0.9"
                android:src="@drawable/outline_location_on_24"
                android:translationY="-2dp"
                app:layout_constraintBottom_toBottomOf="@+id/card_home_user_profile_pic"
                app:layout_constraintStart_toEndOf="@+id/card_home_user_profile_pic"
                app:layout_constraintTop_toBottomOf="@+id/text_home_welcome_user"
                app:tint="?attr/colorOnPrimary" />

            <TextView
                android:id="@+id/text_home_welcome_user_area"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_fragment_welcome_user_area"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="16sp"
                app:layout_constraintStart_toEndOf="@+id/img_home_welcome_user_location"
                app:layout_constraintTop_toBottomOf="@+id/text_home_welcome_user" />

        </androidx.constraintlayout.widget.ConstraintLayout>


        <!--  Google Map Section  -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/map_home_container"
            class="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cl_home_user_info"
            tools:visibility="gone" />

        <!--  Ride Search Bar  -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_home_search_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ss_screen_width_margin"
            android:layout_marginEnd="@dimen/ss_screen_width_margin"
            android:translationY="-27dp"
            app:cardBackgroundColor="?attr/colorOnPrimarySurface"
            app:cardCornerRadius="100000dp"
            app:cardElevation="3dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cl_home_user_info"
            app:strokeWidth="0dp">

            <LinearLayout
                android:id="@+id/ll_home_search_bar_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp"
                android:paddingStart="16dp"
                android:paddingEnd="14dp">

                <EditText
                    android:id="@+id/edit_text_home_search_bar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="@font/poppins_semibold"
                    android:hint="@string/home_fragment_search_hint"
                    android:inputType="text"
                    android:maxLines="1"
                    android:padding="0dp"
                    android:textColor="?android:attr/textColorHintInverse"
                    android:textColorHint="?attr/colorOutline"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/img_btn_home_seearch_bar_foward"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#00FFFFFF"
                    android:cropToPadding="false"
                    android:src="@drawable/baseline_arrow_forward_24" />
            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/text_home_nearby_rides_section"
            style="@style/text_section_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ss_screen_width_margin"
            android:layout_marginEnd="@dimen/ss_screen_width_margin"
            android:text="@string/home_section_recent_rides_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/card_home_search_bar" />

        <HorizontalScrollView
            android:id="@+id/horizontalScrollView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollIndicators="none"
            android:scrollbarSize="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/text_home_nearby_rides_section">

            <LinearLayout
                android:id="@+id/ll_home_nearby_rides_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:padding="2dp"
                android:paddingStart="@dimen/ss_screen_width_margin">

                <!--  Card 1  -->
                <androidx.cardview.widget.CardView
                    android:layout_width="@dimen/ss_home_recent_rides_card_width"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="8dp">

                        <androidx.cardview.widget.CardView
                            style="@style/ImageCardViewStyle"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/ss_home_recent_rides_card_image_height"
                            android:layout_marginBottom="8dp">

                            <ImageView
                                android:id="@+id/imageView"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:scaleType="fitXY"
                                app:srcCompat="@drawable/ride_to_downtown" />
                        </androidx.cardview.widget.CardView>


                        <TextView
                            android:id="@+id/textView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="Ride to Downtown" />

                        <TextView
                            android:id="@+id/textView2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp"
                            android:text="2 km away"
                            android:textColor="@android:color/system_neutral2_500"
                            android:textSize="12sp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!--  Card 2  -->
                <androidx.cardview.widget.CardView
                    android:layout_width="@dimen/ss_home_recent_rides_card_width"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="8dp">

                        <androidx.cardview.widget.CardView
                            style="@style/ImageCardViewStyle"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/ss_home_recent_rides_card_image_height"
                            android:layout_marginBottom="8dp">

                            <ImageView
                                android:id="@+id/imageView2"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:scaleType="fitXY"
                                app:srcCompat="@drawable/ride_to_airport" />
                        </androidx.cardview.widget.CardView>


                        <TextView
                            android:id="@+id/textView3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="Ride to Airport" />

                        <TextView
                            android:id="@+id/textView4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp"
                            android:text="2 km away"
                            android:textColor="@android:color/system_neutral2_500"
                            android:textSize="12sp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!--  Card 3  -->
                <androidx.cardview.widget.CardView
                    android:layout_width="@dimen/ss_home_recent_rides_card_width"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="8dp">

                        <androidx.cardview.widget.CardView
                            style="@style/ImageCardViewStyle"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/ss_home_recent_rides_card_image_height"
                            android:layout_marginBottom="8dp">

                            <ImageView
                                android:id="@+id/imageView3"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:scaleType="fitXY"
                                app:srcCompat="@drawable/ride_to_downtown" />
                        </androidx.cardview.widget.CardView>


                        <TextView
                            android:id="@+id/textView5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="Ride to Downtown" />

                        <TextView
                            android:id="@+id/textView6"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp"
                            android:text="2 km away"
                            android:textColor="@android:color/system_neutral2_500"
                            android:textSize="12sp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/text_home_recent_rides_section"
            style="@style/text_section_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ss_screen_width_margin"
            android:layout_marginTop="27dp"
            android:layout_marginEnd="@dimen/ss_screen_width_margin"
            android:text="@string/home_section_categories_rides_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/horizontalScrollView" />

        <!--  Categories Section  -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ss_screen_width_margin"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="@dimen/ss_screen_width_margin"
            android:background="#00FFFFFF"
            android:gravity="left|end"
            android:orientation="horizontal"
            android:padding="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/text_home_recent_rides_section">

            <!--  Card 1: Shopping Mall  -->
            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#00FFFFFF"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <androidx.cardview.widget.CardView
                        android:layout_width="@dimen/ss_home_categories_card_image_width_height"
                        android:layout_height="@dimen/ss_home_categories_card_image_width_height"
                        android:layout_marginBottom="6dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:contentPadding="14dp">

                        <ImageView
                            android:id="@+id/imageView4"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:srcCompat="@drawable/baseline_local_mall_24" />
                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:id="@+id/textView7"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:text="Mall" />
                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!--  Card 2: Airport  -->
            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#00FFFFFF"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <androidx.cardview.widget.CardView
                        android:layout_width="@dimen/ss_home_categories_card_image_width_height"
                        android:layout_height="@dimen/ss_home_categories_card_image_width_height"
                        android:layout_marginBottom="6dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:contentPadding="14dp">

                        <ImageView
                            android:id="@+id/imageView5"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:srcCompat="@drawable/baseline_local_airport_24" />
                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:id="@+id/textView8"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:text="Airport" />
                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!--  Card 3: Station  -->
            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#00FFFFFF"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <androidx.cardview.widget.CardView
                        android:layout_width="@dimen/ss_home_categories_card_image_width_height"
                        android:layout_height="@dimen/ss_home_categories_card_image_width_height"
                        android:layout_marginBottom="6dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="5dp"
                        app:contentPadding="14dp">

                        <ImageView
                            android:id="@+id/imageView6"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:srcCompat="@drawable/baseline_directions_bus_24" />
                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:id="@+id/textView9"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:text="Station" />
                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />


            <!--  Card 4: Unknown  -->
            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#00FFFFFF"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <androidx.cardview.widget.CardView
                        android:layout_width="@dimen/ss_home_categories_card_image_width_height"
                        android:layout_height="@dimen/ss_home_categories_card_image_width_height"
                        android:layout_marginBottom="6dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="5dp"
                        app:contentPadding="14dp">

                        <ImageView
                            android:id="@+id/imageView7"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:srcCompat="@drawable/baseline_stars_24" />
                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:id="@+id/textView10"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:text="Unknown" />
                </LinearLayout>

            </androidx.cardview.widget.CardView>
        </LinearLayout>


