<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".screen.navigation.HomeFragment">


        <!--  User Info Section  -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_home_user_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorPrimaryVariant"
            android:paddingTop="@dimen/ss_screen_top_margin"
            android:visibility="visible"
            app:layout_constraintTop_toTopOf="parent"
            tools:layout_editor_absoluteX="24dp"
            tools:visibility="visible">

            <!--  Profile Picture  -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_home_user_profile_pic"
                android:layout_width="@dimen/ss_home_pic_size"
                android:layout_height="@dimen/ss_home_pic_size"
                android:layout_marginStart="@dimen/ss_screen_width_margin"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="#00FFFFFF"
                app:cardCornerRadius="1000dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.5"
                app:strokeColor="#00FFFFFF">

                <ImageView
                    android:id="@+id/img_user_profile_pic"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:srcCompat="@drawable/baseline_account_circle_24"
                    app:tint="?attr/colorOnPrimary" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/text_home_welcome_user"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/home_fragment_welcome_user"
                android:textColor="?attr/colorOnPrimary"
                app:layout_constraintBottom_toTopOf="@+id/img_home_welcome_user_location"
                app:layout_constraintStart_toEndOf="@+id/card_home_user_profile_pic"
                app:layout_constraintTop_toTopOf="@+id/card_home_user_profile_pic" />

            <ImageView
                android:id="@+id/img_home_welcome_user_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:scaleX="0.8"
                android:scaleY="0.8"
                android:src="@drawable/outline_location_on_24"
                android:translationY="-5dp"
                app:layout_constraintBottom_toBottomOf="@+id/card_home_user_profile_pic"
                app:layout_constraintStart_toEndOf="@+id/card_home_user_profile_pic"
                app:layout_constraintTop_toBottomOf="@+id/text_home_welcome_user"
                app:tint="?attr/colorOnPrimary" />

            <TextView
                android:id="@+id/text_home_welcome_user_area"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_fragment_welcome_user_area"
                android:textColor="?attr/colorOnPrimary"
                app:layout_constraintStart_toEndOf="@+id/img_home_welcome_user_location"
                app:layout_constraintTop_toBottomOf="@+id/text_home_welcome_user" />

        </androidx.constraintlayout.widget.ConstraintLayout>


        <!--  Google Map Section  -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/map_home_container"
            class="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cl_home_user_info"
            tools:visibility="visible" />


        <!--  Ride Offer Section  -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_home_main_menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            app:cardCornerRadius="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.5">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_home_main_menu_tab_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ss_screen_width_margin"
                    android:layout_marginTop="@dimen/ss_screen_top_margin"
                    android:layout_marginEnd="@dimen/ss_screen_width_margin"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="4dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/tab_home_main_menu"
                        style="@style/CustomTabLayout"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_alignParentTop="true"
                        android:background="?attr/colorSurfaceVariant"
                        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tabIndicator="?attr/colorSurfaceDim"
                        app:tabIndicatorAnimationMode="elastic"
                        app:tabIndicatorFullWidth="true"
                        app:tabIndicatorGravity="stretch"
                        app:tabMode="fixed"
                        app:tabPaddingBottom="@dimen/ss_home_find_ride_tab_vertical_padding"
                        app:tabPaddingTop="@dimen/ss_home_find_ride_tab_vertical_padding"
                        app:tabSelectedTextColor="?attr/colorOnSecondary"
                        app:tabTextAppearance="@style/TabTextStyle"
                        app:tabTextColor="?attr/colorOnSurfaceVariant" />

                </com.google.android.material.card.MaterialCardView>

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/viewPager_home_main_menu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/card_home_main_menu_tab_container"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/card_home_main_menu_tab_container" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>