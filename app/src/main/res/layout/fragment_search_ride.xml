<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="@dimen/ss_screen_width_margin">

        <!--  Row 1  -->
        <LinearLayout
            android:id="@+id/ll_search_top_section_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/img_btn_search_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#00FFFFFF"
                android:padding="8dp"
                android:scaleX="1.1"
                android:scaleY="1.1"
                android:src="@drawable/baseline_arrow_back_24"
                android:translationX="-11dp"
                app:tint="?attr/colorOnBackground"
                tools:layout_editor_absoluteX="24dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="64dp"
                android:layout_weight="1"
                android:gravity="center">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:cardCornerRadius="@dimen/ss_rounded_background_corner_radius"
                    app:contentPadding="4dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal">

                        <!--  Now  -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/card_search_now"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            app:cardBackgroundColor="?attr/colorPrimary"
                            app:cardCornerRadius="@dimen/ss_rounded_background_corner_radius"
                            app:contentPaddingBottom="4dp"
                            app:contentPaddingLeft="16dp"
                            app:contentPaddingRight="16dp"
                            app:contentPaddingTop="4dp"
                            app:strokeWidth="0dp">


                            <TextView
                                android:id="@+id/text_search_now"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_medium"
                                android:text="@string/search_fragment_now"
                                android:textColor="?attr/colorOnPrimary" />
                        </com.google.android.material.card.MaterialCardView>

                        <!--  Schedule  -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/card_search_schedule"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="?android:attr/windowSplashScreenBackground"
                            app:cardCornerRadius="@dimen/ss_rounded_background_corner_radius"
                            app:contentPaddingBottom="4dp"
                            app:contentPaddingLeft="8dp"
                            app:contentPaddingRight="8dp"
                            app:contentPaddingTop="4dp"
                            app:strokeWidth="0dp">


                            <TextView
                                android:id="@+id/text_search_schedule"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/search_fragment_schedule"
                                android:textColor="?attr/colorOutline" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

        </LinearLayout>

        <!--  Row 2  -->
        <LinearLayout
            android:id="@+id/ll_search_top_section_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="@dimen/ss_screen_width_margin">

            <!--  Space  -->
            <Space
                android:layout_width="42dp"
                android:layout_height="match_parent" />


            <!--  Input: Pick Up Location  -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_offer_ride_pick_up_location"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardBackgroundColor="#00FFFFFF"
                app:cardCornerRadius="@dimen/ss_rounded_background_corner_radius"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/img_btn_offer_ride_pick_up"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ss_home_input_field_width_margin"
                        android:background="#00FFFFFF"
                        android:scaleX="0.6"
                        android:scaleY="0.6"
                        android:src="@drawable/baseline_trip_origin_24"
                        app:tint="?attr/colorPrimaryDark" />

                    <EditText
                        android:id="@+id/edit_text_offer_ride_pick_up_location"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="#00FFFFFF"
                        android:fontFamily="@font/poppins_medium"
                        android:hint="@string/home_fragment_pick_up_location"
                        android:inputType="text"
                        android:maxLines="1"
                        android:paddingStart="@dimen/ss_home_input_field_horizontal_padding"
                        android:paddingTop="@dimen/ss_home_input_field_vertical_padding"
                        android:paddingEnd="@dimen/ss_home_input_field_horizontal_padding"
                        android:paddingBottom="@dimen/ss_home_input_field_vertical_padding"
                        android:text="Current location"
                        android:textSize="14sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!--  Button: Choose Role  -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_search_change_role_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:gravity="center_horizontal|center_vertical"
                    android:orientation="vertical"
                    android:translationX="9dp">

                    <ImageButton
                        android:id="@+id/img_btn_search_change_role"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#00FFFFFF"
                        android:elevation="3dp"
                        android:paddingStart="8dp"
                        android:paddingLeft="8dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="8dp"
                        android:paddingRight="8dp"
                        android:paddingBottom="2dp"
                        android:src="@drawable/baseline_steering_24"
                        app:tint="?attr/colorOnBackground" />

                    <TextView
                        android:id="@+id/text_search_change_role"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:text="@string/search_fragment_change_role_to_driver"
                        android:textSize="10sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!--  Row 3  -->
        <LinearLayout
            android:id="@+id/ll_search_top_section_row_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="@dimen/ss_screen_width_margin">

            <!--  Space  -->
            <Space
                android:layout_width="42dp"
                android:layout_height="match_parent" />

            <!--  Input: Destination/Drop Off Location  -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_offer_ride_destination_location"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:cardCornerRadius="@dimen/ss_rounded_background_corner_radius"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@+id/card_offer_ride_pick_up_location"
                app:strokeWidth="0dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center|center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/img_btn_offer_ride_destination"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ss_home_input_field_width_margin"
                        android:background="#00FFFFFF"
                        android:scaleX="0.6"
                        android:scaleY="0.6"
                        android:src="@drawable/baseline_trip_origin_24"
                        app:tint="?attr/colorError" />

                    <EditText
                        android:id="@+id/edit_text_offer_ride_destination_location"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="#00FFFFFF"
                        android:fontFamily="@font/poppins_medium"
                        android:hint="@string/home_fragment_destination_location"
                        android:maxLines="1"
                        android:paddingStart="@dimen/ss_home_input_field_horizontal_padding"
                        android:paddingTop="@dimen/ss_home_input_field_vertical_padding"
                        android:paddingEnd="@dimen/ss_home_input_field_horizontal_padding"
                        android:paddingBottom="@dimen/ss_home_input_field_vertical_padding"
                        android:textColorHint="?android:attr/textColorHint"
                        android:textSize="14sp" />
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!--  Button: Choose Region  -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_search_change_region_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:translationX="9dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:gravity="center_horizontal|center_vertical"
                    android:orientation="vertical">

                    <androidx.cardview.widget.CardView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginLeft="8dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginRight="8dp"
                        android:layout_marginBottom="2dp"
                        app:cardCornerRadius="10000dp">

                        <ImageButton
                            android:id="@+id/img_btn_search_change_region"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#00FFFFFF"
                            android:src="@drawable/kuala_lumpur" />
                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:id="@+id/text_search_change_state"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:text="Kuala L"
                        android:textSize="10sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!--  Search Result  -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_search_place_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="@dimen/ss_screen_width_margin"
            android:paddingBottom="8dp"
            android:visibility="visible"
            tools:listitem="@layout/recycler_item_search_place_result"
            tools:visibility="visible" />

    </LinearLayout>

</layout>