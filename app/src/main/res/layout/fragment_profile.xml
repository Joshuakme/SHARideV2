<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="viewModel"
            type="com.example.sharidev2.viewmodel.LoginViewModel" />
    </data>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurfaceContainer"
        tools:context=".screen.navigation.ProfileFragment">

        <!--  Already Login  .-->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:isScrollContainer="false">

            <!--  Section: User Info  -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_profile_user_basic_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp"
                app:cardBackgroundColor="?attr/colorPrimary"
                app:cardElevation="0dp"
                app:layout_constraintBottom_toTopOf="@+id/view_profile_rounded_background"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="@dimen/ss_screen_width_margin"
                    android:paddingTop="@dimen/ss_screen_top_margin"
                    android:paddingEnd="@dimen/ss_screen_width_margin">

                    <!--  Profile Picture  -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_profile_section_profile_image"
                        android:layout_width="@dimen/ss_profile_pic_size"
                        android:layout_height="@dimen/ss_profile_pic_size"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="500dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:id="@+id/image_profile"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Default Profile Image"
                            android:src="@drawable/baseline_account_circle_24" />
                    </androidx.cardview.widget.CardView>


                    <!--  User Info  -->
                    <LinearLayout
                        android:id="@+id/ll_user_detail"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:layoutDirection="ltr"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="@+id/card_profile_section_profile_image"
                        app:layout_constraintStart_toEndOf="@+id/card_profile_section_profile_image"
                        app:layout_constraintTop_toTopOf="@+id/card_profile_section_profile_image">

                        <TextView
                            android:id="@+id/text_profile_display_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:contentDescription="@string/placeholder_profile_user_display_name"
                            android:fontFamily="@font/poppins_semibold"
                            android:includeFontPadding="false"
                            android:text="@string/placeholder_profile_user_display_name"
                            android:textColor="?attr/colorOnPrimary"
                            android:textSize="24sp" />

                        <TextView
                            android:id="@+id/text_profile_user_id"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:contentDescription="@string/placeholder_profile_user_userid"
                            android:fontFamily="@font/poppins"
                            android:includeFontPadding="false"
                            android:text="@string/placeholder_profile_user_userid"
                            android:textColor="?android:attr/textColorSecondaryInverse"
                            android:textSize="14sp" />
                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>


            <View
                android:id="@+id/view2"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="?attr/colorPrimary"
                android:translationY="-4dp"
                app:layout_constraintBottom_toTopOf="@+id/card_profile_section_my_account"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/card_profile_user_basic_info" />

            <View
                android:id="@+id/view_profile_rounded_background"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/background_rounded_top"
                android:backgroundTint="?attr/colorSurfaceContainer"
                android:paddingBottom="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/card_profile_user_basic_info" />


            <!--  Section: My Account  -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_profile_section_my_account"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ss_screen_width_margin"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="@dimen/ss_screen_width_margin"
                app:cardCornerRadius="@dimen/ss_rounded_background_corner_radius"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/view_profile_rounded_background"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:id="@+id/ll_my_account"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/text_profile_section_title_my_account"
                        style="@style/text_section_title"
                        android:layout_marginBottom="16dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="@string/profile_section_title_my_account"
                        android:textColor="?android:attr/textColorPrimary"
                        android:visibility="gone"
                        tools:visibility="gone" />

                    <!--  List of menu  -->
                    <!--  Personal Information  -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_personal_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/ss_profile_section_item_bottom_margin"
                        app:cardBackgroundColor="#00FFFFFF"
                        app:cardElevation="0dp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <TextView
                                android:id="@+id/text_profile_subsection_title_personal_info"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/profile_subsection_title_personal_info"
                                android:textColor="?android:attr/textColorSecondary"
                                app:layout_constraintEnd_toStartOf="@+id/img_btn_personal_information_next"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <ImageButton
                                android:id="@+id/img_btn_personal_information_next"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:background="#00FFFFFF"
                                android:src="@drawable/baseline_keyboard_arrow_right_24"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:tint="?attr/colorOutlineVariant" />

                            <View
                                android:id="@+id/divider_personal_information"
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_marginTop="16dp"
                                android:background="?android:attr/listDivider"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/text_profile_subsection_title_personal_info" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.cardview.widget.CardView>
                    <!--  Payment Method  -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_payment_method"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/ss_profile_section_item_bottom_margin"
                        app:cardBackgroundColor="#00FFFFFF"
                        app:cardElevation="0dp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <TextView
                                android:id="@+id/text_profile_subsection_title_payment_method"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/profile_subsection_title_payment_method"
                                android:textColor="?android:attr/textColorSecondary"
                                app:layout_constraintEnd_toStartOf="@+id/img_btn_payment_method_next"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <ImageButton
                                android:id="@+id/img_btn_payment_method_next"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:background="#00FFFFFF"
                                android:src="@drawable/baseline_keyboard_arrow_right_24"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:tint="?attr/colorOutlineVariant" />

                            <View
                                android:id="@+id/divider_payment_method"
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_marginTop="16dp"
                                android:background="?android:attr/listDivider"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/text_profile_subsection_title_payment_method" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.cardview.widget.CardView>
                    <!--  Addresses  -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_addresses"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/ss_profile_section_item_bottom_margin"
                        app:cardBackgroundColor="#00FFFFFF"
                        app:cardElevation="0dp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <TextView
                                android:id="@+id/text_profile_subsection_title_addresses"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/profile_subsection_title_addresses"
                                app:layout_constraintEnd_toStartOf="@+id/img_btn_addresses_next"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <ImageButton
                                android:id="@+id/img_btn_addresses_next"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:background="#00FFFFFF"
                                android:src="@drawable/baseline_keyboard_arrow_right_24"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:tint="?attr/colorOutlineVariant" />

                            <View
                                android:id="@+id/divider_addresses"
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_marginTop="16dp"
                                android:background="?android:attr/listDivider"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/text_profile_subsection_title_addresses" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.cardview.widget.CardView>
                    <!--  Emergency Contact  -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_emergency_contact"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="#00FFFFFF"
                        app:cardElevation="0dp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <TextView
                                android:id="@+id/text_profile_subsection_title_emergency_contact"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/profile_subsection_title_emergency_contact"
                                app:layout_constraintEnd_toStartOf="@+id/img_btn_emergency_contact_next"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <ImageButton
                                android:id="@+id/img_btn_emergency_contact_next"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:background="#00FFFFFF"
                                android:src="@drawable/baseline_keyboard_arrow_right_24"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:tint="?attr/colorOutlineVariant" />

                            <View
                                android:id="@+id/divider_emergency_contact"
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_marginTop="16dp"
                                android:background="?android:attr/listDivider"
                                android:visibility="gone"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/text_profile_subsection_title_emergency_contact"
                                tools:visibility="gone" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>


            <!--  Section: General  -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_profile_section_general"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ss_screen_width_margin"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="@dimen/ss_screen_width_margin"
                android:padding="16dp"
                app:cardCornerRadius="@dimen/ss_rounded_background_corner_radius"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/card_profile_section_my_account"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:id="@+id/ll_general"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/text_profile_section_title_general"
                        style="@style/text_section_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_section_title_general"
                        android:visibility="gone"
                        tools:visibility="gone" />

                    <!--  List of menu  -->
                    <!--  Help Center  -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_help_center"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/ss_profile_section_item_bottom_margin"
                        app:cardBackgroundColor="#00FFFFFF"
                        app:cardElevation="0dp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <TextView
                                android:id="@+id/text_profile_subsection_title_help_center"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/profile_subsection_title_help_center"
                                app:layout_constraintEnd_toStartOf="@+id/img_btn_help_center_next"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <ImageButton
                                android:id="@+id/img_btn_help_center_next"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:background="#00FFFFFF"
                                android:src="@drawable/baseline_keyboard_arrow_right_24"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:tint="?attr/colorOutlineVariant" />

                            <View
                                android:id="@+id/divider_default"
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_marginTop="16dp"
                                android:background="?android:attr/listDivider"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/text_profile_subsection_title_help_center" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.cardview.widget.CardView>
                    <!--  Settings  -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_settings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/ss_profile_section_item_bottom_margin"
                        app:cardBackgroundColor="#00FFFFFF"
                        app:cardElevation="0dp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <TextView
                                android:id="@+id/text_profile_subsection_title_settings"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/profile_subsection_title_settings"
                                app:layout_constraintEnd_toStartOf="@+id/img_btn_settings_next"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <ImageButton
                                android:id="@+id/img_btn_settings_next"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:background="#00FFFFFF"
                                android:src="@drawable/baseline_keyboard_arrow_right_24"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:tint="?attr/colorOutlineVariant" />

                            <View
                                android:id="@+id/divider_settings"
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_marginTop="16dp"
                                android:background="?android:attr/listDivider"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/text_profile_subsection_title_settings" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.cardview.widget.CardView>
                    <!--  Feedback  -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_feedback"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/ss_profile_section_item_bottom_margin"
                        app:cardBackgroundColor="#00FFFFFF"
                        app:cardElevation="0dp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <TextView
                                android:id="@+id/text_profile_subsection_title_feedback"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/profile_subsection_title_feedback"
                                app:layout_constraintEnd_toStartOf="@+id/img_btn_feedback_next"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <ImageButton
                                android:id="@+id/img_btn_feedback_next"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:background="#00FFFFFF"
                                android:src="@drawable/baseline_keyboard_arrow_right_24"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:tint="?attr/colorOutlineVariant" />

                            <View
                                android:id="@+id/divider_feedback"
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_marginTop="16dp"
                                android:background="?android:attr/listDivider"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/text_profile_subsection_title_feedback" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.cardview.widget.CardView>
                    <!--  About  -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_about"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/ss_profile_section_item_bottom_margin"
                        app:cardBackgroundColor="#00FFFFFF"
                        app:cardElevation="0dp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <TextView
                                android:id="@+id/text_profile_subsection_title_about"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/profile_subsection_title_about"
                                app:layout_constraintEnd_toStartOf="@+id/img_btn_about_next"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <ImageButton
                                android:id="@+id/img_btn_about_next"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:background="#00FFFFFF"
                                android:src="@drawable/baseline_keyboard_arrow_right_24"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:tint="?attr/colorOutlineVariant" />

                            <View
                                android:id="@+id/divider_about"
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_marginTop="16dp"
                                android:background="?android:attr/listDivider"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/text_profile_subsection_title_about" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.cardview.widget.CardView>
                    <!--  Delete My Account  -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_delete_my_account"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="#00FFFFFF"
                        app:cardElevation="0dp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <TextView
                                android:id="@+id/text_profile_subsection_title_delete_my_account"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/profile_subsection_title_delete_my_account"
                                app:layout_constraintEnd_toStartOf="@+id/img_btn_delete_my_account_next"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <ImageButton
                                android:id="@+id/img_btn_delete_my_account_next"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:background="#00FFFFFF"
                                android:src="@drawable/baseline_keyboard_arrow_right_24"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:tint="?attr/colorOutlineVariant" />

                            <View
                                android:id="@+id/divider_delete_my_account"
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_marginTop="16dp"
                                android:background="?android:attr/listDivider"
                                android:visibility="gone"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="parent"
                                tools:visibility="gone" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>


            <!--  Button: Log Out  -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_profile_logout_btn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ss_screen_width_margin"
