<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical">


    <TextView
        android:id="@+id/textView11"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ss_screen_width_margin"
        android:layout_marginTop="@dimen/ss_screen_top_margin"
        android:layout_marginEnd="@dimen/ss_screen_width_margin"
        android:layout_marginBottom="@dimen/ss_profile_section_item_bottom_margin"
        android:fontFamily="@font/poppins_medium"
        android:text="@string/search_fragment_choose_timing_title" />


    <com.example.sharidev2.utility.DateTimePicker
        android:id="@+id/date_picker_bottom_dialog_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />



    <!-- Row: CTA Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/ss_screen_width_margin">

        <!-- Cancel Button -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_search_timing_cta_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:clickable="false"
            android:contextClickable="false"
            android:longClickable="false"
            app:cardBackgroundColor="#00FFFFFF"
            app:cornerRadius="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_login_verify_code_divider"
            app:strokeColor="?attr/colorPrimary"
            app:strokeWidth="1dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:contextClickable="false"
                android:longClickable="false">

                <TextView
                    android:id="@+id/text_search_timing_cta_btn_cancel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:contextClickable="false"
                    android:enabled="false"
                    android:fontFamily="@font/poppins_semibold"
                    android:gravity="center"
                    android:linksClickable="false"
                    android:longClickable="false"
                    android:padding="14dp"
                    android:text="@string/search_fragment_choose_timing_cta_cancel"
                    android:textColor="?attr/colorPrimary"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.5" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- Cancel Button -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_search_timing_cta_confirm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="false"
            android:contextClickable="false"
            android:longClickable="false"
            app:cardBackgroundColor="?attr/colorPrimary"
            app:cornerRadius="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_login_verify_code_divider"
            app:strokeWidth="0dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:contextClickable="false"
                android:longClickable="false">

                <TextView
                    android:id="@+id/text_search_timing_cta_btn_confirm"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:contextClickable="false"
                    android:enabled="false"
                    android:fontFamily="@font/poppins_semibold"
                    android:gravity="center"
                    android:linksClickable="false"
                    android:longClickable="false"
                    android:padding="14dp"
                    android:text="@string/search_fragment_choose_timing_cta_confirm"
                    android:textColor="?attr/colorOnPrimary"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.5" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>



</LinearLayout>