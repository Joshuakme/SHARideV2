<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingBottom="32dp">


            <!--  Top Nav  -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ss_home_nav_top_padding"
                android:layout_marginBottom="16dp">

                <ImageButton
                    android:id="@+id/btn_back_add_vehicle_doc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ss_screen_width_margin"
                    android:background="#00FFFFFF"
                    android:scaleX="@dimen/ss_profile_subfragment_nav_icon_scale"
                    android:scaleY="@dimen/ss_profile_subfragment_nav_icon_scale"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.5"
                    app:srcCompat="@drawable/baseline_arrow_back_24"
                    app:tint="?attr/colorOnBackground" />

                <TextView
                    android:id="@+id/tv_vehicle_doc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:text="Vehicle Details"
                    android:textAlignment="center"
                    android:textSize="@dimen/fs_fragment_title"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.5" />

            </androidx.constraintlayout.widget.ConstraintLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/ss_screen_width_margin">

                <!--  Personal Info  -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_personal_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:cardCornerRadius="@dimen/ss_rounded_background_corner_radius"
                    app:contentPadding="8dp"
                    app:contentPaddingBottom="8dp"
                    app:contentPaddingTop="8dp"
                    app:strokeWidth="0dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layout_vehicle_first_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:boxBackgroundColor="?attr/colorSurfaceContainer"
                            app:boxBackgroundMode="filled"
                            app:boxStrokeColor="@color/mtrl_outlined_stroke_color"
                            android:layout_marginBottom="@dimen/ss_profile_title_top_margin"
                            inp="@string/edit_vehicle_doc_fragment_name_allowed_characters"
                            android:paddingTop="@dimen/ss_input_field_vertical_padding">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/input_vehicle_first_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="First Name"
                                android:inputType="text"
                                android:paddingVertical="15dp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layout_vehicle_last_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:boxBackgroundColor="?attr/colorSurfaceContainer"
                            app:boxBackgroundMode="filled"
                            app:boxStrokeColor="@color/mtrl_outlined_stroke_color"
                            android:digits="@string/edit_vehicle_doc_fragment_name_allowed_characters"
                            android:paddingTop="@dimen/ss_input_field_vertical_padding"
                            android:paddingBottom="@dimen/ss_input_field_vertical_padding">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/input_vehicle_last_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Last Name"
                                android:inputType="text"
                                android:paddingVertical="15dp" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!--  Vehicle Info  -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_driving_license"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:cardCornerRadius="@dimen/ss_rounded_background_corner_radius"
                    app:contentPadding="12dp"
                    app:contentPaddingLeft="12dp"
                    app:contentPaddingRight="12dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/card_spinner_vehicle_type"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:layout_marginTop="@dimen/ss_profile_title_top_margin"
                            android:layout_marginBottom="@dimen/ss_profile_title_top_margin"
                            app:cardBackgroundColor="@android:color/transparent"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/md_theme_onSurfaceVariant"
                            app:cardCornerRadius="5dp">

                        <Spinner
                            android:id="@+id/spinner_vehicle_type"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:layout_marginBottom="20dp"
                            android:clickable="true"
                            android:entries="@array/name"
                            android:scrollbarSize="5dp" />
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layout_vehicle_brand"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginBottom="8dp"
                            app:boxBackgroundColor="?attr/colorSurfaceContainer"
                            app:boxBackgroundMode="filled"
                            android:digits="@string/edit_vehicle_doc_fragment_name_allowed_characters"
                            android:paddingTop="@dimen/ss_input_field_vertical_padding"
                            android:paddingBottom="@dimen/ss_input_field_vertical_padding">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/input_vehicle_brand"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Vehicle Brand" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layout_vehicle_model"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginBottom="8dp"
                            app:boxBackgroundColor="?attr/colorSurfaceContainer"
                            app:boxBackgroundMode="filled"
                            android:digits="@string/edit_vehicle_doc_fragment_name_allowed_characters"
                            android:paddingTop="@dimen/ss_input_field_vertical_padding"
                            android:paddingBottom="@dimen/ss_input_field_vertical_padding">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/input_vehicle_model"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Vehicle Model" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layout_vehicle_color"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginBottom="8dp"
                            app:boxBackgroundColor="?attr/colorSurfaceContainer"
                            app:boxBackgroundMode="filled"
                            android:digits="@string/edit_vehicle_doc_fragment_name_allowed_characters"
                            android:paddingTop="@dimen/ss_input_field_vertical_padding"
                            android:paddingBottom="@dimen/ss_input_field_vertical_padding">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/input_vehicle_color"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Vehicle Color" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layout_vehicle_capacity"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginBottom="8dp"
                            app:boxBackgroundColor="?attr/colorSurfaceContainer"
                            app:boxBackgroundMode="filled"
                            android:paddingTop="@dimen/ss_input_field_vertical_padding"
                            android:paddingBottom="@dimen/ss_input_field_vertical_padding">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/input_vehicle_capacity"
                                android:layout_width="match_parent"
                                android:inputType="number"
                                android:layout_height="wrap_content"
                                android:hint="Vehicle Capacity" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layout_car_plate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            app:boxBackgroundColor="?attr/colorSurfaceContainer"
                            app:boxBackgroundMode="filled"
                            android:digits="@string/edit_vehicle_doc_fragment_car_plate_allowed_characters"
                            android:paddingTop="@dimen/ss_input_field_vertical_padding"
                            android:paddingBottom="@dimen/ss_input_field_vertical_padding">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/input_car_plate"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Car Plate" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:id="@+id/date_manufacture"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ems="10"
                            android:hint="Manufacture Date"
                            android:inputType="number"
                            android:minHeight="48dp"
                            android:paddingTop="@dimen/ss_input_field_vertical_padding"
                            android:paddingBottom="@dimen/ss_input_field_vertical_padding"
                            />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_next_vehicle_doc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="50dp"
                    app:cardBackgroundColor="?attr/colorPrimary"
                    app:cardCornerRadius="@dimen/ss_rounded_background_corner_radius"
                    app:strokeWidth="0dp">

                    <TextView
                        android:id="@+id/text_next_vehicle_doc"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="Next"
                        android:textColor="?attr/colorOnPrimary" />

                    <ProgressBar
                        android:id="@+id/progress_bar_verify_vehicle_doc"
                        style="@android:style/Widget.Holo.Light.ProgressBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:visibility="invisible"
                        tools:visibility="invisible" />
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </LinearLayout>

    </androidx.core.widget.NestedScrollView>
</layout>