<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingBottom="32dp">


            <!--  Top Nav  -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ss_home_nav_top_padding"
                android:layout_marginBottom="16dp">

                <ImageButton
                    android:id="@+id/btn_back_edit_vehicle_doc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ss_screen_width_margin"
                    android:background="#00FFFFFF"
                    android:scaleX="@dimen/ss_profile_subfragment_nav_icon_scale"
                    android:scaleY="@dimen/ss_profile_subfragment_nav_icon_scale"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.5"
                    app:srcCompat="@drawable/baseline_arrow_back_24"
                    app:tint="?attr/colorOnBackground" />

                <TextView
                    android:id="@+id/tv_vehicle_doc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:text="Vehicle Documentations"
                    android:textAlignment="center"
                    android:textSize="@dimen/fs_fragment_title"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.5" />

            </androidx.constraintlayout.widget.ConstraintLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/ss_screen_width_margin">

                <!--  Personal Info  -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_personal_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:cardCornerRadius="@dimen/ss_rounded_background_corner_radius"
                    app:contentPadding="8dp"
                    app:contentPaddingBottom="8dp"
                    app:contentPaddingTop="8dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layout_vehicle_first_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            app:boxBackgroundColor="?attr/colorSurfaceContainer"
                            app:boxBackgroundMode="filled"
                            app:boxStrokeColor="@color/mtrl_outlined_stroke_color">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/input_vehicle_first_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="First Name"
                                android:paddingVertical="15dp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layout_vehicle_last_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:boxBackgroundColor="?attr/colorSurfaceContainer"
                            app:boxBackgroundMode="filled"
                            app:boxStrokeColor="@color/mtrl_outlined_stroke_color">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/input_vehicle_last_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Last Name"
                                android:paddingVertical="15dp" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!--  Vehicle Info  -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_vehicle_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:cardCornerRadius="@dimen/ss_rounded_background_corner_radius"
                    app:contentPadding="12dp"
                    app:contentPaddingLeft="12dp"
                    app:contentPaddingRight="12dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <Spinner
                            android:id="@+id/spinner_vehicle_type"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginBottom="8dp"
                            android:clickable="true"
                            android:entries="@array/name"
                            android:paddingTop="@dimen/ss_input_field_vertical_padding"
                            android:scrollbarSize="5dp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layout_car_plate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            app:boxBackgroundColor="?attr/colorSurfaceContainer"
                            app:boxBackgroundMode="filled">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/input_car_plate"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Car Plate" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layout_vehicle_model"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginBottom="8dp"
                            app:boxBackgroundColor="?attr/colorSurfaceContainer"
                            app:boxBackgroundMode="filled">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/input_vehicle_model"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Vehicle Model" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <EditText
                            android:id="@+id/date_manufacture"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ems="10"
                            android:hint="Manufacture Date"
                            android:inputType="number"
                            android:minHeight="48dp"
                            android:paddingTop="@dimen/ss_input_field_vertical_padding"
                            android:paddingBottom="@dimen/ss_input_field_vertical_padding" />


                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>


                <!--  Vehicle Registration Cert  -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_vehicle_reg_cert"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:cardCornerRadius="@dimen/ss_rounded_background_corner_radius"
                    app:contentPadding="12dp"
                    app:contentPaddingLeft="12dp"
                    app:contentPaddingRight="12dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_vehicle_reg_cert"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:fontFamily="@font/poppins_medium"
                            android:text="Vehicle Registration  Certification"
                            android:textSize="@dimen/text_margin" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal"
                            tools:ignore="MissingConstraints">

                            <ImageView
                                android:id="@+id/vehicle_reg_cert"
                                android:layout_width="140dp"
                                android:layout_height="140dp"
                                android:scaleType="centerCrop"
                                android:src="@mipmap/ic_launcher" />


                            <Button
                                android:id="@+id/btn_upload_cert"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="40dp"
                                android:text="Upload File" />


                        </LinearLayout>
                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!--  Vehicle Road Tax  -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_vehicle_roadtax"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:cardCornerRadius="@dimen/ss_rounded_background_corner_radius"
                    app:contentPadding="12dp"
                    app:contentPaddingLeft="12dp"
                    app:contentPaddingRight="12dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_roadtax"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:fontFamily="@font/poppins_medium"
                            android:text="Vehicle Road Tax"
                            android:textSize="@dimen/text_margin" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal"
                            tools:ignore="MissingConstraints">

                            <ImageView
                                android:id="@+id/vehicle_roadtax"
                                android:layout_width="140dp"
                                android:layout_height="140dp"
                                android:scaleType="fitCenter"
                                android:src="@mipmap/ic_launcher" />

                            <Button
                                android:id="@+id/btn_upload_roadtax"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="40dp"
                                android:text="Upload File" />
                        </LinearLayout>
                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!--  Vehicle Insurance  -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_vehicle_insurance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:cardCornerRadius="@dimen/ss_rounded_background_corner_radius"
                    app:contentPadding="12dp"
                    app:contentPaddingLeft="12dp"
                    app:contentPaddingRight="12dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_vehicle_insurance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:text="Vehicle Insurance"
                            android:textSize="@dimen/text_margin" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal"
                            tools:ignore="MissingConstraints">

                            <ImageView
                                android:id="@+id/vehicle_insurance"
                                android:layout_width="140dp"
                                android:layout_height="140dp"
                                android:scaleType="fitCenter"
                                android:src="@mipmap/ic_launcher" />

                            <Button
                                android:id="@+id/btn_upload_insurance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="40dp"
                                android:text="Upload File" />
                        </LinearLayout>
                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!--  Save Button  -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/save_vehicle_record"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    app:cardBackgroundColor="?attr/colorPrimaryContainer"
                    app:cardCornerRadius="@dimen/ss_rounded_background_corner_radius"
                    app:strokeWidth="0dp">

                    <TextView
                        android:id="@+id/textView15"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_medium"
                        android:gravity="center"
                        android:paddingVertical="14dp"
                        android:text="Save Record"
                        android:textColor="?attr/colorOnPrimaryContainer" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>
</layout>