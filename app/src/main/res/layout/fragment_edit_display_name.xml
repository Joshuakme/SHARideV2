<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:id="@+id/ll_edit_username_title"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:gravity="center_horizontal|top"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_edit_username_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="16dp">

            <ImageView
                android:id="@+id/btn_back_edit_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ss_screen_width_margin"
                android:scaleX="0.9"
                android:scaleY="0.9"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.5"
                app:srcCompat="@drawable/baseline_arrow_back_24"
                app:tint="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/tv_edit_username_title"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:fontFamily="@font/poppins_medium"
                android:gravity="center"
                android:text="Edit Name"
                android:textSize="@dimen/fs_profile_subfragment_title"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.5" />

            <TextView
                android:id="@+id/btn_update_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ss_screen_width_margin"
                android:text="Save"
                android:textColor="?attr/colorPrimary"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.5" />


        </androidx.constraintlayout.widget.ConstraintLayout>



                <LinearLayout
                    android:id="@+id/ll_edit_username"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#00FFFFFF"
                    android:orientation="vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layout_edit_username"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ss_screen_width_margin"
                        android:layout_marginTop="24dp"
                        android:layout_marginEnd="@dimen/ss_screen_width_margin"
                        android:digits="@string/edit_username_fragment_allowed_characters"
                        android:hint="Name"
                        android:inputType="text"
                        android:textColorHint="?android:attr/textColorHint"
                        app:boxCornerRadiusBottomEnd="@dimen/ss_rounded_background_corner_radius"
                        app:boxCornerRadiusBottomStart="@dimen/ss_rounded_background_corner_radius"
                        app:boxCornerRadiusTopEnd="@dimen/ss_rounded_background_corner_radius"
                        app:boxCornerRadiusTopStart="@dimen/ss_rounded_background_corner_radius"
                        app:helperTextTextColor="@color/md_theme_error"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/input_edit_username"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:backgroundTintMode="multiply"
                            android:inputType="text"
                            android:maxLength="24"
                            android:paddingTop="15dp"
                            android:paddingBottom="15dp"
                            app:counterEnabled="true" />
                    </com.google.android.material.textfield.TextInputLayout>


                    <TextView
                        android:id="@+id/tv_message_set_username"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/ss_screen_width_margin"
                        android:paddingHorizontal="8dp"
                        android:paddingTop="@dimen/ss_home_input_field_vertical_padding"
                        android:text="@string/edit_username_fragment_message_set_username"
                        android:textColor="?android:attr/textColorHint" />


                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginHorizontal="@dimen/ss_screen_width_margin"
                        android:translationY="-106dp"
                        android:visibility="gone"
                        app:cardBackgroundColor="?attr/colorSurfaceContainer"
                        app:cardCornerRadius="@dimen/ss_rounded_background_corner_radius"
                        app:strokeWidth="0dp"
                        tools:visibility="gone" />

                </LinearLayout>
    </LinearLayout>
</layout>
