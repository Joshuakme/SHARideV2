<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="viewModel"
            type="com.example.sharidev2.viewmodel.SharedCreateRideViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/ss_screen_width_margin"
        android:paddingEnd="@dimen/ss_screen_width_margin"
        tools:context=".screen.ride.RideDetailConfigurationFragment">

        <!--  Fragment Nav Title  -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_profile_personal_info_upper_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/ss_screen_top_margin"
            android:paddingBottom="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:context=".screen.profile.PersonalInformationFragment">


            <!--  Button: Back  -->
            <ImageButton
                android:id="@+id/img_btn_driver_ride_config_nav_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#00FFFFFF"
                android:scaleX="@dimen/ss_profile_subfragment_nav_icon_scale"
                android:scaleY="@dimen/ss_profile_subfragment_nav_icon_scale"
                android:src="@drawable/baseline_arrow_back_24"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="?attr/colorOnBackground" />

            <!--  Fragment Nav Title  -->
            <TextView
                android:id="@+id/text_fragment_title_driver_ride_config"
                style="@style/text_fragment_title_profile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:gravity="center"
                android:text="@string/driver_ride_config_fragment_title_new_ride_config"
                android:textColor="?attr/colorOnBackground"
                android:textSize="@dimen/fs_fragment_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!--  Ride Details  -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_driver_ride_config_ride_detail_map"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/ss_section_bottom_margin"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:cardCornerRadius="@dimen/ss_rounded_background_corner_radius"
            app:strokeWidth="0dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!--  Ride Origin  -->
                <ImageButton
                    android:id="@+id/img_btn_driver_ride_config_origin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#00FFFFFF"
                    android:scaleX="0.7"
                    android:scaleY="0.7"
                    android:src="@drawable/baseline_trip_origin_24"
                    app:layout_constraintBottom_toBottomOf="@+id/text_driver_ride_config_origin"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/text_driver_ride_config_origin"
                    app:tint="?attr/colorPrimaryDark" />

                <TextView
                    android:id="@+id/text_driver_ride_config_origin"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="Origin Location"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/img_btn_driver_ride_config_origin"
                    app:layout_constraintTop_toTopOf="parent" />

                <!--  Ride Destination  -->
                <ImageButton
                    android:id="@+id/img_btn_driver_ride_config_destination"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#00FFFFFF"
                    android:scaleX="0.7"
                    android:scaleY="0.7"
                    android:src="@drawable/baseline_trip_origin_24"
                    app:layout_constraintBottom_toBottomOf="@+id/text_driver_ride_config_destination"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/text_driver_ride_config_destination"
                    app:tint="?attr/colorError" />

                <TextView
                    android:id="@+id/text_driver_ride_config_destination"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/poppins_medium"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/home_fragment_destination_location"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/img_btn_driver_ride_config_destination"
                    app:layout_constraintTop_toBottomOf="@+id/text_driver_ride_config_origin" />


            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <!--  Ride Additional Option  -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_driver_ride_config_additional_option"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:cardCornerRadius="@dimen/ss_rounded_background_corner_radius"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp">

                <!--  Vehicle Type  -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_driver_ride_config_vehicle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/ss_ride_detail_config_item_margin_bottom"
                    app:cardBackgroundColor="#00FFFFFF"
                    app:cardCornerRadius="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <!--  Vehicle Type  -->
                        <TextView
                            android:id="@+id/text_driver_ride_config_vehicle"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:text="@string/driver_create_ride_fragment_section_title_vehicle"
                            android:textColor="?android:attr/textColorHint"
                            android:textSize="@dimen/fs_ride_detail_config_item_text_size"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/spinner_driver_ride_config_vehicle"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            app:cardBackgroundColor="#00FFFFFF"
                            app:cardCornerRadius="0dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center">

                                <TextView
                                    android:id="@+id/text_driver_ride_config_spinner_vehicle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:clickable="false"
                                    android:fontFamily="@font/poppins"
                                    android:text='@{viewModel.vehicle != null ? viewModel.vehicle.plateNumber  : " - "}'
                                    android:textSize="15sp" />

                                <ImageButton
                                    android:id="@+id/img_btn_driver_ride_config_spinner_choose_vehicle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:background="#00FFFFFF"
                                    android:clickable="false"
                                    android:src="@drawable/baseline_arrow_drop_down_24"
                                    app:tint="?attr/colorOnSurface" />
                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!--  Customize Ride Capacity  -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_driver_ride_config_ride_capacity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/ss_ride_detail_config_item_margin_bottom"
                    app:cardBackgroundColor="#00FFFFFF"
                    app:cardCornerRadius="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <!--  Vehicle Type  -->
                        <TextView
                            android:id="@+id/text_driver_ride_config_ride_capacity"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:text="@string/driver_create_ride_fragment_section_title_passenger_capacity"
                            android:textColor="?android:attr/textColorHint"
                            android:textSize="@dimen/fs_ride_detail_config_item_text_size"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/spinner_driver_ride_config_ride_capacity"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            app:cardBackgroundColor="#00FFFFFF"
                            app:cardCornerRadius="0dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:clickable="false"
                                android:gravity="center">

                                <TextView
                                    android:id="@+id/text_driver_ride_config_spinner_ride_capacity"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:clickable="false"
                                    android:fontFamily="@font/poppins"
                                    android:text='@{viewModel.vehicle != null ? Integer.toString(viewModel.vehicle.capacity) : "-"}'
                                    android:textSize="15sp" />

                                <ImageButton
                                    android:id="@+id/img_btn_driver_ride_config_spinner_choose_ride_capacity"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="#00FFFFFF"
                                    android:clickable="false"
                                    android:src="@drawable/baseline_arrow_drop_down_24"
                                    app:tint="?attr/colorOnSurface" />
                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!--  Schedule Date  -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_driver_ride_config_schedule_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/ss_ride_detail_config_item_margin_bottom"
                    app:cardBackgroundColor="#00FFFFFF"
                    app:cardCornerRadius="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <!--  Vehicle Type  -->
                        <TextView
                            android:id="@+id/text_driver_ride_config_schedule_date"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:text="@string/ride_detail_config_fragment_section_title_schedule_date"
                            android:textColor="?android:attr/textColorHint"
                            android:textSize="@dimen/fs_ride_detail_config_item_text_size"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/spinner_driver_ride_config_schedule_date"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            app:cardBackgroundColor="#00FFFFFF"
                            app:cardCornerRadius="0dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center">

                                <TextView
                                    android:id="@+id/text_driver_ride_config_spinner_schedule_date"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:clickable="false"
                                    android:fontFamily="@font/poppins"
                                    android:textSize="15sp" />

                                <ImageButton
                                    android:id="@+id/img_btn_driver_ride_config_spinner_choose_schedule_date"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:background="#00FFFFFF"
                                    android:clickable="false"
                                    android:src="@drawable/baseline_arrow_drop_down_24"
                                    app:tint="?attr/colorOnSurface" />
                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!--  Schedule Time  -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_driver_ride_config_schedule_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#00FFFFFF"
                    app:cardCornerRadius="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <!--  Vehicle Type  -->
                        <TextView
                            android:id="@+id/text_driver_ride_config_schedule_time"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:text="@string/ride_detail_config_fragment_section_title_schedule_time"
                            android:textColor="?android:attr/textColorHint"
                            android:textSize="@dimen/fs_ride_detail_config_item_text_size"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/spinner_driver_ride_config_schedule_time"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            app:cardBackgroundColor="#00FFFFFF"
                            app:cardCornerRadius="0dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center">

                                <TextView
                                    android:id="@+id/text_driver_ride_config_spinner_schedule_time"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:clickable="false"
                                    android:fontFamily="@font/poppins"
                                    android:textSize="15sp" />

                                <ImageButton
                                    android:id="@+id/img_btn_driver_ride_config_spinner_choose_schedule_time"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:background="#00FFFFFF"
                                    android:clickable="false"
                                    android:src="@drawable/baseline_arrow_drop_down_24"
                                    app:tint="?attr/colorOnSurface" />
                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!--  CTA Button  -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_driver_ride_config_cta_create_ride"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            app:cardBackgroundColor="?attr/colorPrimary"
            app:cornerRadius="@dimen/ss_rounded_background_corner_radius"
            app:strokeWidth="0dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="false">

                <TextView
                    android:id="@+id/text_driver_ride_config_cta_create_ride"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:fontFamily="@font/poppins_semibold"
                    android:gravity="center"
                    android:padding="14dp"
                    android:text="@string/ride_detail_config_fragment_cta_button_create_ride"
                    android:textColor="?attr/colorOnPrimary"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.5" />

                <ProgressBar
                    android:id="@+id/progress_bar_driver_ride_cta_create_ride"
                    style="@android:style/Widget.Holo.Light.ProgressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@+id/text_driver_ride_config_cta_create_ride"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.5"
                    tools:visibility="gone" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</layout>