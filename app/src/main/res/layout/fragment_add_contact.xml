<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:id="@+id/ll_add_emergency_contact"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_add_emergency_contact_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ss_screen_top_margin">

            <ImageView
                android:id="@+id/btn_back_add_contact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ss_screen_width_margin"
                android:scaleX="@dimen/ss_profile_subfragment_nav_icon_scale"
                android:scaleY="@dimen/ss_profile_subfragment_nav_icon_scale"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.454"
                app:srcCompat="@drawable/baseline_arrow_back_24"
                app:tint="?attr/colorOnBackground" />

            <TextView
                android:id="@+id/tv_add_emergency_contact_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:text="Add Emergency Contact"
                android:textAlignment="center"
                android:textSize="@dimen/fs_fragment_title"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/btn_save_contact_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ss_screen_width_margin"
                android:text="Add"
                android:textColor="?attr/colorPrimary"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/ll_cv_add_emergency_contact_details"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_contact_details"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardBackgroundColor="#00FFFFFF"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:id="@+id/ll_add_emergency_contact_details"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layout_emergency_name"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ss_screen_width_margin"
                        android:layout_marginTop="24dp"
                        android:layout_marginEnd="@dimen/ss_screen_width_margin"
                        android:hint="Name"
                        app:boxCornerRadiusBottomEnd="@dimen/ss_rounded_background_corner_radius"
                        app:boxCornerRadiusBottomStart="@dimen/ss_rounded_background_corner_radius"
                        app:boxCornerRadiusTopEnd="@dimen/ss_rounded_background_corner_radius"
                        app:boxCornerRadiusTopStart="@dimen/ss_rounded_background_corner_radius"
                        app:helperText="Required*"
                        app:helperTextTextColor="@color/md_theme_error"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/tv_emergency_contact_title"
                        app:startIconDrawable="@drawable/baseline_account_circle_24">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/input_emergency_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="15dp"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layout_emergency_phone_no"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ss_screen_width_margin"
                        android:layout_marginTop="24dp"
                        android:layout_marginEnd="@dimen/ss_screen_width_margin"
                        android:hint="Phone Number"
                        app:boxCornerRadiusBottomEnd="@dimen/ss_rounded_background_corner_radius"
                        app:boxCornerRadiusBottomStart="@dimen/ss_rounded_background_corner_radius"
                        app:boxCornerRadiusTopEnd="@dimen/ss_rounded_background_corner_radius"
                        app:boxCornerRadiusTopStart="@dimen/ss_rounded_background_corner_radius"
                        app:counterEnabled="true"
                        app:counterMaxLength="10"
                        app:helperText="Required*"
                        app:helperTextTextColor="@color/md_theme_error"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/layout_emergency_name"
                        app:prefixText="+60"
                        app:prefixTextColor="@color/black"
                        app:startIconDrawable="@drawable/baseline_phone_24">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/input_emergency_phone_no"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:paddingVertical="15dp" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <Button
                        android:id="@+id/btn_update_contact_detail"
                        android:layout_width="match_parent"
                        android:layout_height="66dp"
                        android:layout_marginStart="50dp"
                        android:layout_marginEnd="50dp"
                        android:text="Update Record"
                        android:visibility="invisible"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/layout_emergency_phone_no" />

                    <Button
                        android:id="@+id/btn_delete_contact_detail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="50dp"
                        android:layout_marginEnd="50dp"
                        android:text="Delete Record"
                        android:visibility="invisible"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/layout_emergency_phone_no" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </LinearLayout>
</layout>