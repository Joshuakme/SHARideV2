<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bottom_dialog_background"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <!--  Top Indicator  -->
    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="100000dp">

        <View
            android:id="@+id/view_bottom_dialog_top_indicator"
            android:layout_width="35dp"
            android:layout_height="5dp"
            android:background="@color/system_neutral2_500" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/text_bottom_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:fontFamily="@font/poppins_semibold"
        android:text="@string/login_fragment_bottom_dialog_title"
        android:textAlignment="center"
        android:textColor="?attr/colorOnBackground"
        android:textSize="18sp"
        android:visibility="gone"
        tools:visibility="gone" />


    <!--  Search bar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_bottom_dialog_search_country_code"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:clipToPadding="true"
        app:contentPadding="-4dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainer"
        app:strokeWidth="0dp">

        <androidx.appcompat.widget.SearchView
            android:id="@+id/search_bottom_dialog_country_code"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:queryHint="Search"
            app:iconifiedByDefault="false"
            app:queryBackground="@android:color/transparent"/>

    </com.google.android.material.card.MaterialCardView>




    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_bottom_dialog_country_code"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>