<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ss_home_nav_top_padding">

            <ImageButton
                android:id="@+id/btn_back_vehicle_doc"
                android:layout_width="56dp"
                android:layout_height="30dp"
                android:layout_marginTop="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.045"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.0"
                app:srcCompat="@drawable/baseline_arrow_back_24" />

            <TextView
                android:id="@+id/tv_vehicle_doc"
                android:layout_width="274dp"
                android:layout_height="47dp"
                android:fontFamily="@font/robotomedium"
                android:text="Vehicle Documentations"
                android:textAlignment="center"
                android:textSize="@dimen/fs_fragment_title"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.635"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.0" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/ss_home_input_field_bottom_margin"
            android:layout_marginBottom="@dimen/ss_home_input_field_bottom_margin"
            android:layout_weight="1"
            android:paddingStart="@dimen/ss_screen_width_margin"
            android:paddingEnd="@dimen/ss_screen_width_margin">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cv_personal_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#00FFFFFF"
                    app:contentPaddingTop="@dimen/ss_input_field_vertical_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layout_vehicle_first_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/ss_profile_title_top_margin"
                            android:paddingTop="@dimen/ss_input_field_vertical_padding">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/input_vehicle_first_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="First Name" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layout_vehicle_last_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingTop="@dimen/ss_input_field_vertical_padding"
                            android:paddingBottom="@dimen/ss_home_nav_top_padding">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/input_vehicle_last_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Last Name" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cv_vehicle_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:contentPaddingTop="@dimen/ss_input_field_vertical_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <Spinner
                            android:id="@+id/spinner_vehicle_type"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:layout_marginTop="@dimen/ss_profile_title_top_margin"
                            android:layout_marginBottom="@dimen/ss_profile_title_top_margin"
                            android:clickable="true"
                            android:entries="@array/name"
                            android:paddingTop="@dimen/ss_input_field_vertical_padding"
                            android:scrollbarSize="5dp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layout_car_plate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingTop="@dimen/ss_input_field_vertical_padding"
                            android:paddingBottom="@dimen/ss_input_field_vertical_padding">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/input_car_plate"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Car Plate" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layout_vehicle_model"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:paddingTop="@dimen/ss_input_field_vertical_padding"
                            android:paddingBottom="@dimen/ss_input_field_vertical_padding">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/input_vehicle_model"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Vehicle Model" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <EditText
                            android:id="@+id/date_manufacture"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ems="10"
                            android:inputType="number"
                            android:minHeight="48dp"
                            android:hint="Manufacture Date"
                            android:paddingTop="@dimen/ss_input_field_vertical_padding"
                            android:paddingBottom="@dimen/ss_input_field_vertical_padding"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="40dp">

                            <TextView
                                android:id="@+id/tv_vehicle_reg_cert"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:paddingTop="@dimen/ss_input_field_vertical_padding"
                                android:paddingBottom="@dimen/ss_input_field_vertical_padding"
                                android:text="Vehicle Registration  Certification"
                                android:textSize="@dimen/text_margin"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:gravity="center"
                            android:orientation="horizontal"
                            tools:ignore="MissingConstraints">

                            <ImageView
                                android:id="@+id/vehicle_reg_cert"
                                android:layout_width="140dp"
                                android:layout_height="140dp"
                                android:scaleType="fitCenter"
                                android:src="@mipmap/ic_launcher" />


                            <Button
                                android:id="@+id/btn_upload_cert"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="40dp"
                                android:text="Upload File" />


                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="40dp">
                            <TextView
                                android:id="@+id/tv_roadtax"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Vehicle Road Tax"
                                android:textStyle="bold"
                                android:textSize="@dimen/text_margin"
                                android:paddingTop="@dimen/ss_input_field_vertical_padding"
                                android:paddingBottom="@dimen/ss_input_field_vertical_padding"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:gravity="center"
                            android:orientation="horizontal"
                            tools:ignore="MissingConstraints">

                            <ImageView
                                android:id="@+id/vehicle_roadtax"
                                android:layout_width="140dp"
                                android:layout_height="140dp"
                                android:scaleType="fitCenter"
                                android:src="@mipmap/ic_launcher" />

                            <Button
                                android:id="@+id/btn_upload_roadtax"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="40dp"
                                android:text="Upload File" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="40dp">
                            <TextView
                                android:id="@+id/tv_vehicle_insurance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Vehicle Insurance"
                                android:textStyle="bold"
                                android:textSize="@dimen/text_margin"
                                android:paddingTop="@dimen/ss_input_field_vertical_padding"
                                android:paddingBottom="@dimen/ss_input_field_vertical_padding"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:gravity="center"
                            android:orientation="horizontal"
                            tools:ignore="MissingConstraints">

                            <ImageView
                                android:id="@+id/vehicle_insurance"
                                android:layout_width="140dp"
                                android:layout_height="140dp"
                                android:scaleType="fitCenter"
                                android:src="@mipmap/ic_launcher" />

                            <Button
                                android:id="@+id/btn_upload_insurance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="40dp"
                                android:text="Upload File" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/save_vehicle_record"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="50dp"
                            android:text="Save Record" />


                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</layout>