<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ss_home_nav_top_padding">

            <ImageView
                android:id="@+id/btn_back_vehicle_doc"
                android:layout_width="56dp"
                android:layout_height="30dp"
                android:layout_marginTop="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.045"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.0"
                app:srcCompat="@drawable/baseline_arrow_back_24" />

            <TextView
                android:id="@+id/tv_vehicle_doc"
                android:layout_width="274dp"
                android:layout_height="47dp"
                android:fontFamily="@font/robotomedium"
                android:text="Vehicle Documentations"
                android:textAlignment="center"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.635"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.0" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/ss_home_input_field_bottom_margin"
            android:layout_marginBottom="@dimen/ss_home_input_field_bottom_margin"
            android:layout_weight="1"
            android:paddingStart="@dimen/ss_screen_width_margin"
            android:paddingEnd="@dimen/ss_screen_width_margin">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cv_personal_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#00FFFFFF"
                    app:contentPaddingTop="@dimen/ss_input_field_vertical_padding">

                    <TextView
                        android:id="@+id/tv_personal_information"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Personal Information"
                        android:textSize="@dimen/ss_profile_personal_info_item_text_size"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layout_vehicle_first_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ss_profile_title_top_margin"
                            android:layout_marginBottom="@dimen/ss_profile_title_top_margin"
                            android:paddingTop="@dimen/ss_input_field_vertical_padding">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/input_vehicle_first_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="First Name" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layout_vehicle_last_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingTop="@dimen/ss_input_field_vertical_padding"
                            android:paddingBottom="@dimen/ss_home_nav_top_padding">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/input_vehicle_last_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Last Name" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cv_vehicle_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:contentPaddingTop="@dimen/ss_input_field_vertical_padding">

                    <TextView
                        android:id="@+id/tv_vehicle_information"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vehicle Information"
                        android:textSize="@dimen/ss_profile_personal_info_item_text_size"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <Spinner
                            android:id="@+id/spinner_vehicle_type"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:layout_marginTop="@dimen/ss_profile_title_top_margin"
                            android:layout_marginBottom="@dimen/ss_profile_title_top_margin"
                            android:clickable="true"
                            android:entries="@array/name"
                            android:paddingTop="@dimen/ss_input_field_vertical_padding"
                            android:scrollbarSize="5dp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layout_car_plate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingTop="@dimen/ss_input_field_vertical_padding"
                            android:paddingBottom="@dimen/ss_input_field_vertical_padding">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/input_car_plate"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Car Plate" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <com.google.android.material.textfield.TextInputEditText
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="hint" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <com.google.android.material.textfield.TextInputEditText
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="hint" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <com.google.android.material.textfield.TextInputEditText
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="hint" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</layout>