<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navigation"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.sharidev2.screen.navigation.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_homeFragment_to_searchFragment"
            app:destination="@id/searchFragment" />
    </fragment>
    <fragment
        android:id="@+id/messagesFragment"
        android:name="com.example.sharidev2.screen.navigation.MessagesFragment"
        android:label="fragment_messages"
        tools:layout="@layout/fragment_messages" >
        <action
            android:id="@+id/action_messagesFragment_to_chatFragment"
            app:destination="@id/chatFragment" />
    </fragment>
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.sharidev2.screen.navigation.ProfileFragment"
        android:label="fragment_profile"
        tools:layout="@layout/fragment_profile" >
        <action
            android:id="@+id/action_profileFragment_to_personalInformationFragment"
            app:destination="@id/personalInformationFragment" />
        <action
            android:id="@+id/action_profileFragment_to_paymentMethodFragment"
            app:destination="@id/paymentMethodFragment" />
        <action
            android:id="@+id/action_profileFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>
    <fragment
        android:id="@+id/bookingFragment"
        android:name="com.example.sharidev2.screen.navigation.BookingFragment"
        android:label="fragment_booking"
        tools:layout="@layout/fragment_booking" />
    <fragment
        android:id="@+id/chatFragment"
        android:name="com.example.sharidev2.screen.chatroom.ChatFragment"
        android:label="fragment_chat"
        tools:layout="@layout/fragment_chat" >
        <action
            android:id="@+id/action_chatFragment_to_messagesFragment"
            app:destination="@id/messagesFragment"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.sharidev2.screen.ride.SearchRideFragment"
        android:label="SearchFragment" >
        <action
            android:id="@+id/action_searchFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_searchFragment_to_searchSelectOriginFragment"
            app:destination="@id/searchSelectOriginFragment">
            <argument
                android:name="originName"
                app:argType="string"
                android:defaultValue="No place selected" />
            <argument
                android:name="originDetailedAddress"
                app:argType="string"
                android:defaultValue="No place selected" />
            <argument
                android:name="location"
                app:argType="string"
                android:defaultValue="No place selected" />
        </action>
    </fragment>
    <fragment
        android:id="@+id/personalInformationFragment"
        android:name="com.example.sharidev2.screen.profile.PersonalInformationFragment"
        android:label="PersonalInformationFragment" >
        <action
            android:id="@+id/action_personalInformationFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
    </fragment>
    <fragment
        android:id="@+id/paymentMethodFragment"
        android:name="com.example.sharidev2.screen.profile.PaymentMethodFragment"
        android:label="PaymentMethodFragment" >
        <action
            android:id="@+id/action_paymentMethodFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
    </fragment>
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.sharidev2.screen.user.LoginFragment"
        android:label="LoginFragment" >
        <action
            android:id="@+id/action_loginFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>
    <fragment
        android:id="@+id/searchSelectOriginFragment"
        android:name="com.example.sharidev2.screen.ride.SearchSelectOriginFragment"
        android:label="SearchSelectOriginFragment" >
        <action
            android:id="@+id/action_searchSelectOriginFragment_to_searchFragment"
            app:destination="@id/searchFragment" />
        <action
            android:id="@+id/action_searchSelectOriginFragment_to_rideDetailConfigurationFragment"
            app:destination="@id/rideDetailConfigurationFragment" />
    </fragment>
    <fragment
        android:id="@+id/rideDetailConfigurationFragment"
        android:name="com.example.sharidev2.screen.ride.RideDetailConfigurationFragment"
        android:label="fragment_ride_detail_configuration"
        tools:layout="@layout/fragment_ride_detail_configuration" >
        <action
            android:id="@+id/action_rideDetailConfigurationFragment_to_searchSelectOriginFragment"
            app:destination="@id/searchSelectOriginFragment" />
        <action
            android:id="@+id/action_rideDetailConfigurationFragment_to_matchedRideFragment"
            app:destination="@id/matchedRideFragment" />
    </fragment>
    <fragment
        android:id="@+id/matchedRideFragment"
        android:name="com.example.sharidev2.screen.ride.MatchedRideFragment"
        android:label="fragment_matched_ride"
        tools:layout="@layout/fragment_matched_ride" >
        <action
            android:id="@+id/action_matchedRideFragment_to_rideDetailConfigurationFragment"
            app:destination="@id/rideDetailConfigurationFragment" />
    </fragment>
</navigation>