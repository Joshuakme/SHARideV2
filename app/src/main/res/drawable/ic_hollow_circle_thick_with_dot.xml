<?xml version="1.0" encoding="utf-8"?>
<!-- ic_hollow_circle_with_dot.xml -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer hollow circle -->
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="1.5dp"
                android:color="?attr/colorOutline"/>
            <size
                android:width="24dp"
                android:height="24dp"/>
        </shape>
    </item>
    <!-- Inner filled circle (the dot) -->
    <item
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="?attr/colorOutline"/>
            <size
                android:width="4dp"
                android:height="4dp"/>
        </shape>
    </item>
</layer-list>